PORT=3001
OWNER_EMAIL=owner@empresa.com
# Token exigido no header "Authorization: Bearer <token>" para listar clientes (GET /api/customers).
ADMIN_TOKEN=troque-por-um-token-forte
# E-mail de aviso de novos cadastros. Com RESEND_API_KEY definida, o envio usa o Resend (HTTPS),
# necessário em hospedagens que bloqueiam SMTP, como o Railway nos planos Free/Hobby.
RESEND_API_KEY=
# Opcional: remetente com domínio verificado no Resend. Padrão: EnergiaViva <onboarding@resend.dev>
MAIL_FROM=
# Alternativa: SMTP (funciona localmente ou em hospedagens que liberam SMTP).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-app
