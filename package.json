{
  "name": "energiaviva-gestao-energetica",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "node --disable-warning=ExperimentalWarning server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.0",
    "railway": "^3.16.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
